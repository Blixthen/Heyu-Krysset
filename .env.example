# Copy to .env.local and fill in.

# Shared password for the whole app. Changing it logs everyone out and moves
# the realtime room to a new channel.
APP_PASSWORD=

# Google Gemini, used to find the letter squares in a photo.
GEMINI_API_KEY=
# Optional; defaults to gemini-3-flash-preview.
GEMINI_MODEL=

# Supabase Realtime. Use the publishable/anon key (sb_publishable_…),
# never the secret key: it ends up in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
